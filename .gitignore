## Combined .gitignore for Visual Studio 2022 and JetBrains Rider

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
.idea/
.idea_modules/
*.iml
*.ipr
*.iws

# User-specific folders
.vscode/
.vs/
_ReSharper.Caches/

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Compiled source
*.dll
*.exe
*.pdb
*.cache
*.ilk
*.log
*.lib
*.obj
*.so
*.swp
*.d
*.tlog
*.tmp
*.tmp_proj
*.cmd
*.vcxproj.*
*.idb
*.sbr

# Visual Studio Code
.vscode/

# Windows image file caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Temporary files
*.temp
*.tmp
*.bak
~$*

# Microsoft Patch Files
*.rtf

# Rider caches and logs
.idea/workspace.xml
.idea/dictionaries
.idea/libraries
.idea/shelf/
.idea/httpRequests/
.idea/modules.xml
.idea/codeStyles/
.idea/vcs.xml
.idea/scopes/
.idea/vcs.xml
.idea/jsLibraryMappings.xml

# File-based caches
.idea/workspace/
.idea/workspace-*.xml

# File storage for Rider
.idea/sqlDataSources/
.idea/dataSources/
.idea/dataSources.local/

# Rider logs
.idea/markdown-navigator/

# Rider File Watcher
.idea/fileTemplates/

# Packages
*.nupkg
*.snupkg
.packages/

# Visual Studio profiler
*.vsp
*.vspx
*.sap
*.eap

# T4 files
*.tt
*.ttinclude

# SQL Server files
*.mdf
*.ldf

# Azure DevOps
*.tf

# Python environments
*.pyc
*.pyo
*.pyd
.env/

# Miscellaneous
*.log
*.bak
*.tmp
.idea/.gitignore
